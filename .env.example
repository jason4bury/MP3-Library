# MP3 Library settings. Copy this file to .env next to docker-compose.yml, fill in the values,
# then run:
#   docker compose up -d
# .env holds real passwords and keys: it is gitignored, so never commit it.

# --- Docker (used by docker-compose.yml) ---
# Port on the host: the app is at http://<your-server>:PORT
PORT=3000

# Image tag to run: latest, or a version such as 1.02
MP3_LIBRARY_TAG=latest

# Your music folder on the Docker host (required). Windows: D:/Music  Linux/NAS: /volume1/music
MUSIC_HOST_DIR_1=/path/to/music

# A second music folder (optional): remove the # from the next line and from the collection2
# line in docker-compose.yml, and add /music/collection2 to MUSIC_DIR below.
# MUSIC_HOST_DIR_2=/path/to/more-music

# Artist pictures, one subfolder per artist, e.g. Artist Pictures/Radiohead/folder.jpg (required)
ARTIST_PICTURES_HOST_DIR=/path/to/artist-pictures

# Optional: a host folder for the database, cover art cache and sessions. Leave blank to use a
# named Docker volume (mp3-library-data) instead.
DATA_HOST_DIR=

# --- App ---
# Music folders as the container sees them, comma-separated. With two music folders use
#   MUSIC_DIR=/music/collection1,/music/collection2
MUSIC_DIR=/music/collection1

# Sign-in (required). The app will not start until these are changed from the examples. Use a
# strong password if the app is reachable from the internet.
APP_USERNAME=your-username
APP_PASSWORD=change-me

# Long random string used to sign session cookies (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# Last.fm (optional). A free API key from https://www.last.fm/api/account/create turns on the
# About section on artist and album pages and similar-artist Radio. Add the shared secret too,
# then connect your account in Settings, to scrobble. Leave both blank to skip Last.fm: Radio
# then uses same-genre and same-artist tracks.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# --- Running without Docker (npm start) ---
# Set MUSIC_DIR, ARTIST_PICTURES_DIR and DATA_DIR to real paths on this machine, e.g.
#   MUSIC_DIR=D:/Music
#   ARTIST_PICTURES_DIR=D:/Music/Artist Pictures
#   DATA_DIR=./data
# The Docker settings above are then ignored.

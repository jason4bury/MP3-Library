# MP3 Library settings. Copy this file to .env, fill in the values, then run:
#   docker compose up -d
# .env holds real passwords and keys: it is gitignored, so never commit it.

# Port on the host: the app is at http://<your-server>:PORT
PORT=3000

# Docker image tag to run (latest, or a version such as 1.00)
MP3_LIBRARY_TAG=latest

# --- Folders on THIS machine (the Docker host) ---
# Music folders. One folder only? Leave MUSIC_HOST_DIR_2 out, delete its line in
# docker-compose.yml, and set MUSIC_DIR=/music/collection1 below.
MUSIC_HOST_DIR_1=D:/Music/Collection
MUSIC_HOST_DIR_2=D:/Music/Soundtracks

# Artist pictures, one subfolder per artist, e.g. Artist Pictures/Radiohead/folder.jpg
ARTIST_PICTURES_HOST_DIR=D:/Music/Artist Pictures

# Optional: a host folder for the database and cache. Leave blank to use a named Docker
# volume (mp3-library-data) instead.
DATA_HOST_DIR=

# Music folders as the container sees them, comma-separated. Must match the volumes in
# docker-compose.yml; you normally don't change this.
MUSIC_DIR=/music/collection1,/music/collection2

# --- Sign-in (required) ---
# The app will not start until these are set. Use a strong password if the app is reachable
# from the internet.
APP_USERNAME=your-username
APP_PASSWORD=change-me

# Long random string used to sign session cookies (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# --- Last.fm (optional) ---
# A free API key from https://www.last.fm/api/account/create turns on the About section on
# artist and album pages and similar-artist Radio. Add the shared secret too, then connect your
# account in Settings, to scrobble. Leave both blank to skip Last.fm: Radio then uses
# same-genre and same-artist tracks.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# --- Running without Docker (node server/index.js) ---
# MUSIC_DIR, ARTIST_PICTURES_DIR and DATA_DIR are then real paths on this machine, e.g.
#   MUSIC_DIR=D:/Music/Collection,D:/Music/Soundtracks
#   ARTIST_PICTURES_DIR=D:/Music/Artist Pictures
#   DATA_DIR=./data
# and the *_HOST_DIR settings above are ignored.
